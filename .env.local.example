# Supabase → Project Settings → API
# Copy this file to .env.local and fill in both values, then restart `npm run dev`.

# Project URL (e.g. https://abcdefghijklmnop.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# "anon public" key. This key is shipped to the browser — that is expected.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ Never add the service_role key here, and never prefix any secret with
# NEXT_PUBLIC_. Anything with that prefix is bundled into the client JavaScript.
